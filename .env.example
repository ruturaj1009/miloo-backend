# =============================================================================
# Miloo Backend Environment Template (.env / env.txt)
# =============================================================================

# Server Configuration
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Spring Profile (dev | prod | test)
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase with PostGIS & pgvector)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/miloo_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Hikari Connection Pool Settings
SPRING_DATASOURCE_MAX_POOL_SIZE=10
SPRING_DATASOURCE_MIN_IDLE=2
SPRING_DATASOURCE_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_CONNECTION_TIMEOUT=20000

# JPA & Hibernate Settings
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_FORMAT_SQL=false
SPRING_JPA_HIBERNATE_DEFAULT_SCHEMA=public

# Flyway Database Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_SCHEMAS=public,auth_ctx,people_ctx,interaction_ctx,chat_ctx,ai_ctx

# Multipart File Upload Limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=20MB

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# -----------------------------------------------------------------------------
# 256-bit Hex Encoded HMAC Secret Key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# Auth & Activation Configuration
# -----------------------------------------------------------------------------
AUTH_ACTIVATION_BASE_URL=http://localhost:8080/api/v1/auth/activate
AUTH_ACTIVATION_TTL_HOURS=24
AUTH_MOCK_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Media Storage (Options: r2 | s3 | cloudinary)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=cloudinary
STORAGE_MOCK_ENABLED=true

# Cloudflare R2
R2_ACCOUNT_ID=dummy_account
R2_ACCESS_KEY_ID=dummy_key
R2_SECRET_ACCESS_KEY=dummy_secret
R2_BUCKET_NAME=miloo-media
R2_PUBLIC_DOMAIN=https://pub-media.example.com

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy_key
AWS_SECRET_ACCESS_KEY=dummy_secret
AWS_S3_BUCKET_NAME=miloo-media
AWS_S3_PUBLIC_DOMAIN=https://miloo-media.s3.amazonaws.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=dummy_cloud
CLOUDINARY_API_KEY=dummy_key
CLOUDINARY_API_SECRET=dummy_secret
CLOUDINARY_FOLDER=miloo/users

# -----------------------------------------------------------------------------
# OTP Provider Configuration
# -----------------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MOCK_ENABLED=false
OTP_SMS_PROVIDER=msg91
OTP_EMAIL_PROVIDER=smtp
OTP_MAX_ATTEMPTS=5

# Twilio SMS (Optional fallback)
TWILIO_ACCOUNT_SID=dummy_account_sid
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_FROM_PHONE_NUMBER=+15005550006

# MSG91 SMS
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=MILOO

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=info@miloodating.com
SMTP_FROM_NAME=Miloo Dating

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*

# -----------------------------------------------------------------------------
# Logging Levels
# -----------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MILOO=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_HIBERNATE=INFO
LOGGING_LEVEL_ORG_FLYWAYDB=INFO
